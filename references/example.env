# .env 环境变量配置
# 放在项目根目录下 {ISSUE_DOCS_PREFIX} 目录中，脚本自动加载

# --- 必填参数 ---
# GitHub 仓库 (owner/name)
REPO=nhcf/NanHuInfer
# 基准分支（所有 PR 和 worktree 的基准）
BASE_BRANCH=manager
# GitHub 用户名（被分配人；为空时自动获取当前 gh 登录用户）
ASSIGNEE=Limixxx

# --- 可选参数（带默认值） ---
# 分支名前缀（默认 issue-）
BRANCH_PREFIX=issue-
# Worktree 根目录（相对于仓库根，默认 .worktree）
#WORKTREE_PREFIX=.worktree
# Issue 文档路径前缀（相对于仓库根，默认 .issue）
#ISSUE_DOCS_PREFIX=docs/issue

# --- 看板状态映射（task→status，一对一） ---
# Task1 对应的看板状态名（默认 Backlog）
STATUS_TASK1=Backlog
# Task2 对应的看板状态名（默认 Ready）
STATUS_TASK2=Ready
# Task3 对应的看板状态名（默认 In progress）
STATUS_TASK3=In progress
# Task4 对应的看板状态名（默认 Done）
STATUS_TASK4=Done

# --- 项目看板配置 ---
# GitHub Project Board 名称（默认 REPO）
GITHUB_BOARD_NAME=nhcf/NanHuInfer
# GitHub Project Board 编号
GITHUB_BOARD_NUMBER=4
# GitHub Project Board ID (PVT_...)
GITHUB_BOARD_ID=PVT_kwDODceuz84BXcZ6
# 看板状态字段 ID (PVTSSF_...)
GITHUB_BOARD_STATUS_FIELD_ID=PVTSSF_lADODceuz84BXcZ6zhSpNhE
# Task1 看板状态选项 ID
GITHUB_BOARD_STATUS_TASK1=f75ad846
# Task2 看板状态选项 ID
GITHUB_BOARD_STATUS_TASK2=e18bf179
# Task3 看板状态选项 ID
GITHUB_BOARD_STATUS_TASK3=47fc9ee4
# Task4 看板状态选项 ID
GITHUB_BOARD_STATUS_TASK4=98236657
